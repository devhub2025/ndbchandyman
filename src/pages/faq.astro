---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.js';

const base = import.meta.env.BASE_URL;
const homeUrl = base.endsWith('/') ? base : `${base}/`;
const siteOrigin = Astro.site ? Astro.site.origin : 'https://devhub2025.github.io';

const title = 'FAQ';
const fullTitle = `Handyman Pricing, Guarantee & Service FAQs | ${site.shortName}`;
const description = `Answers to common questions about ${site.name} flat-rate pricing, our 1-year workmanship guarantee, Virginia licensing, insurance, and ${site.regionLabel} service areas.`;

const breadcrumbs = [
  { name: 'Home', href: homeUrl },
  { name: 'FAQ', href: `${homeUrl}faq/` },
];

const faqs = [
  {
    question: 'How do I get a free quote or estimate from NDBC Handyman?',
    answer:
      'You can get a free estimate in two ways: (1) Online — use the estimate form on our Contact page with your name, phone/email, and a brief description of your repair or remodel; online quotes are typically ready within a few hours. (2) On-Site — call (703) 869-4805 to schedule an appointment for us to inspect your project in person; on-site quotes are delivered the same day.',
  },
  {
    question: 'Do you charge by the hour or by a flat rate?',
    answer:
      'We do not charge by the hour. NDBC Handyman provides a clear, competitive flat-rate price for the entire job before work begins, so you never have to worry about slow work or surprise hourly overruns.',
  },
  {
    question: 'What warranty or guarantee comes with your work?',
    answer:
      'We back our maintenance, repair, and remodeling workmanship with a one-year (1-year) guarantee. Guarantee terms may vary for specialty services or owner-supplied materials—ask us for written details with your estimate.',
  },
  {
    question: 'How long does it take to complete a typical handyman or remodeling job?',
    answer:
      'Completion time depends on project scope and material availability. For example, interior painting typically takes about 1 day per 50 square meters (~540 sq ft). Larger kitchen, bathroom, or basement remodels depend on fixture/cabinet delivery schedules and curing times (such as our mandatory 24-hour shower liner leak test before tiling).',
  },
  {
    question: 'Are you licensed and insured in Virginia?',
    answer:
      'Yes. NDBC Handyman Services is licensed in Virginia under the Department of Professional and Occupational Regulation (DPOR) for general building maintenance, remodeling, and home repair, and we carry business and general liability insurance to protect your property while we are on duty.',
  },
  {
    question: 'What payment methods do you accept?',
    answer:
      'We accept cash, personal or business checks, and major credit and debit cards.',
  },
  {
    question: 'Do you offer 24/7 emergency home repair services?',
    answer:
      'Yes. While our regular trading hours are Monday through Saturday from 7:00 AM to 7:00 PM, we provide 24/7 emergency response across Northern Virginia for urgent plumbing leaks, pipe thawing, water damage, and electrical issues. Call (703) 869-4805 anytime.',
  },
  {
    question: 'Which cities and counties in Virginia do you serve?',
    answer: `Dispatched from ${site.primaryCityState}, we serve homeowners across ${site.primaryCounty}, Loudoun County, Fairfax County, Prince William County, and Arlington—including Leesburg, Ashburn, Sterling, Reston, Herndon, McLean, Great Falls, Vienna, Fairfax, Centreville, Chantilly, Gainesville, Haymarket, Manassas, Middleburg, Falls Church, Annandale, Burke, Springfield, and Alexandria.`,
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${new URL(`${homeUrl}faq/`, siteOrigin).toString()}#faqpage`,
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title={title}
  fullTitle={fullTitle}
  description={description}
  breadcrumbs={breadcrumbs}
  pageSchema={faqSchema}
>
  <section class="page-hero">
    <div class="container">
      <h1>Frequently Asked Questions (Ask a Handyman)</h1>
      <p class="lead">
        Direct answers about how {site.name} quotes projects, our flat-rate pricing model, our
        one-year workmanship guarantee, Virginia licensing, and emergency availability.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <div class="ai-summary">
        <p>
          <strong>Direct Answer Summary:</strong> {site.name} provides free online quotes within a
          few hours and same-day written quotes after an on-site visit. All jobs are billed at an
          upfront flat rate (never hourly), backed by a 1-year workmanship warranty, Virginia DPOR
          licensing, and general liability insurance. Cash, check, credit, and debit cards are
          accepted.
        </p>
      </div>

      <div class="section-header">
        <h2 id="faq-heading">Common questions from {site.regionLabel} homeowners</h2>
        <p>
          Select any question below to view our full policy on estimates, project timelines, and
          warranties.
        </p>
      </div>

      <div class="faq-list">
        {faqs.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary>{item.question}</summary>
            <div class="faq-answer">
              <p style="margin: 0;">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="still-questions-heading">
    <div class="container" style="text-align: center;">
      <h2 id="still-questions-heading">Have a question about a specific repair or renovation?</h2>
      <p style="max-width: 640px; margin-inline: auto;">
        Send us your project details or call directly to speak with an experienced handyman serving{' '}
        {site.regionLabel}.
      </p>
      <div class="actions center">
        <a class="btn btn-primary tabular" href={`tel:${site.contact.phone}`}>Call {site.contact.phoneDisplay}</a>
        <a class="btn btn-accent" href={`${homeUrl}contact/`}>Request Your Free Quote</a>
      </div>
    </div>
  </section>
</Layout>
