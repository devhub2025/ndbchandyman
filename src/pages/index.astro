---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.js';

const base = import.meta.env.BASE_URL;
const homeUrl = base.endsWith('/') ? base : `${base}/`;
const fullTitle = `Handyman Services in ${site.primaryCityState} | ${site.name}`;
const description = `Licensed & insured master handyman serving ${site.primaryCity} and Northern Virginia. Flat-rate pricing, 20+ years experience, 1-year guarantee, and 24/7 emergency repairs.`;

const featuredProjects = [
  {
    title: 'Wooden Deck Restoration & Staining',
    badge: `Before & After · ${site.primaryCityState}`,
    image: `${homeUrl}images/portfolio/wood-deck-restoration-painting-before-after.jpg`,
    alt: `Before and after wooden deck restoration, rotted board replacement, and staining in ${site.primaryCityState}`,
    summary: 'USBC code inspection, rotted timber replacement, power washing, sanding, and multi-year exterior stain.',
    href: `${homeUrl}services/deck-restoration/`,
    cta: 'Explore Deck Restoration',
  },
  {
    title: 'Custom Walk-In Tiled Shower Remodel',
    badge: 'Bathroom Remodel · Northern VA',
    image: `${homeUrl}images/portfolio/walk-in-tiled-shower.jpg`,
    alt: 'Custom walk-in tiled shower with recessed shelf and glass enclosure in Northern Virginia',
    summary: 'Tub-to-shower conversion with 24-hour flood-tested waterproof pan liner and floor-to-ceiling ceramic tile.',
    href: `${homeUrl}portfolio/`,
    cta: 'View Bathroom Projects',
  },
  {
    title: 'Patio Pavers & Front Entry Walkways',
    badge: 'Before & After · Loudoun County',
    image: `${homeUrl}images/portfolio/patio-pavers-before-after.jpg`,
    alt: 'Before and after brick paver patio leveling and restoration in Northern Virginia',
    summary: 'Paver re-leveling, stone tile entry steps, pressure washing, and polymeric joint stabilization.',
    href: `${homeUrl}portfolio/`,
    cta: 'See Full Portfolio',
  },
];

const loudounAreas = ['Leesburg', 'Ashburn', 'Sterling', 'Middleburg'];
const fairfaxPwcAreas = [
  'Reston',
  'Herndon',
  'McLean',
  'Great Falls',
  'Vienna',
  'Fairfax',
  'Fairfax Station',
  'Centreville',
  'Chantilly',
  'Clifton',
  'Falls Church',
  'Annandale',
  'Burke',
  'Springfield',
  'Arlington',
  'Alexandria',
  'Gainesville',
  'Haymarket',
  'Manassas',
];
---

<Layout
  fullTitle={fullTitle}
  description={description}
  ogImage={`${homeUrl}images/handyman-owner-doorstep.jpg`}
>
  <section class="hero-doorstep" aria-labelledby="hero-heading">
    <div class="hero-backdrop" aria-hidden="true">
      <img
        src={`${homeUrl}images/handyman-owner-doorstep.jpg`}
        alt=""
        width="1312"
        height="816"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container">
      <div class="hero-stage">
        <div class="hero-copy">
          <h1 id="hero-heading">A Master Craftsman at Your Door—Never a Franchise Crew</h1>
          <p class="lead">
            When you call {site.name}, a seasoned contractor with over 20 years of hands-on Virginia
            building experience knocks on your door, inspects the job personally, and hands you a
            written flat-rate price before any work begins.
          </p>
          <div class="actions">
            <a class="btn btn-accent" href={`${homeUrl}contact/`}>Get a Free Flat-Rate Estimate</a>
            <a class="btn btn-outline-light tabular" href={`tel:${site.contact.phone}`}>
              Call {site.contact.phoneDisplay}
            </a>
          </div>
          <ul class="hero-checks">
            <li>
              <svg class="icon-inline" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M16.5 5.5L8.25 13.75L3.5 9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Virginia DPOR Licensed &amp; Insured
            </li>
            <li>
              <svg class="icon-inline" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M16.5 5.5L8.25 13.75L3.5 9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Written Flat-Rate Price (Never Hourly)
            </li>
            <li>
              <svg class="icon-inline" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M16.5 5.5L8.25 13.75L3.5 9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              1-Year Workmanship Guarantee
            </li>
            <li>
              <svg class="icon-inline" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M16.5 5.5L8.25 13.75L3.5 9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Same-Day On-Site Quotes
            </li>
          </ul>
        </div>

        <aside class="doorstep-dossier" aria-label="Owner-operator doorstep credentials">
          <h2>What to Expect When We Knock</h2>
          <p>
            No rotating subcontractors or open-ended hourly billing. You deal directly with an
            experienced local builder from the first measurement to the final walkthrough.
          </p>
          <dl class="dossier-list">
            <div class="dossier-row">
              <dt>Field Experience</dt>
              <dd>20+ Years in Virginia</dd>
            </div>
            <div class="dossier-row">
              <dt>License &amp; Code</dt>
              <dd>VA DPOR · USBC Compliant</dd>
            </div>
            <div class="dossier-row">
              <dt>Pricing Model</dt>
              <dd>Fixed Flat Fee per Job</dd>
            </div>
            <div class="dossier-row">
              <dt>Warranty</dt>
              <dd>1-Year Written Guarantee</dd>
            </div>
            <div class="dossier-row">
              <dt>Primary Base</dt>
              <dd>{site.primaryCityState}</dd>
            </div>
          </dl>
          <a href={`${homeUrl}about/`} style="color: #86efac; font-weight: 700;">
            Read our full homeowner guarantee &amp; credentials
          </a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="craftsman-profile-heading">
    <div class="container">
      <div class="ai-summary">
        <p>
          <strong>Quick Summary:</strong> {site.name} is a Virginia DPOR-licensed, insured handyman
          and remodeling contractor based in {site.primaryCityState} serving Loudoun, Fairfax, and
          Northern Virginia. Every repair and remodel is quoted at a fixed flat rate (never billed
          by the hour) and backed by a written 1-year workmanship warranty and 24/7 emergency
          support at <a class="tabular" href={`tel:${site.contact.phone}`}>{site.contact.phoneDisplay}</a>.
        </p>
      </div>

      <div class="profile-split">
        <figure class="profile-figure">
          <img
            src={`${homeUrl}images/handyman-owner-inspecting.jpg`}
            alt={`Experienced 60-year-old master handyman inspecting a wooden deck railing with a spirit level and tape measure in ${site.primaryCityState}`}
            width="1200"
            height="896"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Every deck restoration, bathroom remodel, and structural repair begins with a hands-on
            inspection against Virginia Uniform Statewide Building Code (USBC) standards.
          </figcaption>
        </figure>

        <div>
          <h2 id="craftsman-profile-heading">Why Northern Virginia homeowners prefer an experienced craftsman over a franchise</h2>
          <p>
            Over twenty years working with residential homeowners and top property management
            companies has taught us one rule: shortcuts behind the wall or under the deck always cost
            more later. Whether we are flood-testing a custom shower pan for a full 24 hours or
            replacing rotted deck joists before staining, we build it right the first time.
          </p>

          <div class="table-wrap" style="margin-top: 1.25rem;">
            <table class="spec-table">
              <thead>
                <tr>
                  <th scope="col">Homeowner Concern</th>
                  <th scope="col">{site.shortName} Master Handyman</th>
                  <th scope="col">Typical Hourly Franchise</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Who arrives at your door</strong></td>
                  <td>Experienced 20+ year Virginia contractor</td>
                  <td>Rotating hourly technician or subcontractor</td>
                </tr>
                <tr>
                  <td><strong>How projects are priced</strong></td>
                  <td>Written flat-rate quote before work starts</td>
                  <td>Open-ended hourly rate + trip charges</td>
                </tr>
                <tr>
                  <td><strong>Quote turnaround</strong></td>
                  <td>Online in hours · On-site same day</td>
                  <td>Multi-day estimator scheduling window</td>
                </tr>
                <tr>
                  <td><strong>Workmanship protection</strong></td>
                  <td>1-year written guarantee + DPOR licensed</td>
                  <td>Limited 30–90 day callback window</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="showcase-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="showcase-heading">Real before &amp; after projects across Northern Virginia</h2>
        <p>
          Inspect actual repairs and renovations completed in {site.primaryCity}, Loudoun County,
          and Fairfax County—photographed before and after work was completed.
        </p>
      </div>

      <div class="grid grid-3">
        {featuredProjects.map(project => (
          <article class="project-card">
            <div class="project-media">
              <span class="project-badge">{project.badge}</span>
              <img
                src={project.image}
                alt={project.alt}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="project-body">
              <h3>{project.title}</h3>
              <p style="margin: 0 0 0.85rem; color: var(--color-text-light); font-size: 0.95rem;">
                {project.summary}
              </p>
              <a href={project.href} class="project-meta">
                {project.cta}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="services-heading">13 trade categories handled in a single visit</h2>
        <p>
          From urgent plumbing and electrical repairs to full kitchen, bathroom, basement, and deck
          renovations, {site.shortName} handles your entire to-do list under one flat-rate quote.
        </p>
      </div>
      <div class="grid grid-3">
        {site.services.slice(0, 6).map(service => (
          <div class="card">
            <h3>{service.category}</h3>
            <ul class="check-list">
              {service.items.slice(0, 5).map(item => <li>{item}</li>)}
              {service.items.length > 5 && <li><em>Plus {service.items.length - 5} additional services</em></li>}
            </ul>
          </div>
        ))}
      </div>
      <div class="actions center">
        <a class="btn btn-primary" href={`${homeUrl}services/`}>Browse All 13 Service Categories</a>
        <a class="btn btn-secondary" href={`${homeUrl}services/deck-restoration/`}>Wooden Deck Restoration</a>
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="process-heading">How our flat-rate estimate process works</h2>
        <p>
          Whether you need a quick repair or a multi-room renovation, getting a fixed price is
          straightforward and transparent.
        </p>
      </div>
      <div class="grid grid-4">
        <div class="step-card">
          <span class="step-number">Step 1</span>
          <h3>Send Your To-Do List</h3>
          <p style="margin: 0;">Submit our online estimate request or call {site.contact.phoneDisplay} with your repair list or remodel idea.</p>
        </div>
        <div class="step-card">
          <span class="step-number">Step 2</span>
          <h3>Fast Flat-Rate Quote</h3>
          <p style="margin: 0;">Receive an online estimate within a few hours, or schedule an on-site visit for a same-day written flat-fee quote.</p>
        </div>
        <div class="step-card">
          <span class="step-number">Step 3</span>
          <h3>Licensed Craftsmanship</h3>
          <p style="margin: 0;">We arrive on time, protect your floors and furnishings, and complete the work to Virginia USBC building code.</p>
        </div>
        <div class="step-card">
          <span class="step-number">Step 4</span>
          <h3>1-Year Guarantee</h3>
          <p style="margin: 0;">Pay only the agreed flat rate (cash, check, credit, or debit) backed by our written 1-year workmanship warranty.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="areas-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="areas-heading">Counties &amp; communities we serve</h2>
        <p>
          Dispatched from {site.primaryCityState}, {site.name} serves homeowners and property
          managers throughout {site.primaryCounty}, Loudoun County, Fairfax County, Prince William
          County, and Arlington.
        </p>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <h3>{site.primaryCity} &amp; Loudoun County Hub</h3>
          <p>
            Fast dispatch for historic home trim and carpentry, HOA wooden deck restoration,
            kitchen &amp; bath updates, and 24/7 emergency repairs in:
          </p>
          <p style="margin: 0; font-weight: 700; color: var(--color-primary-dark);">
            {Array.from(new Set([site.primaryCity, ...loudounAreas])).join(' · ')}
          </p>
        </div>
        <div class="card">
          <h3>Fairfax, Prince William &amp; Arlington Hub</h3>
          <p>
            Full-service remodeling, tile &amp; flooring installation, plumbing, electrical, and
            preventative property maintenance across:
          </p>
          <p style="margin: 0; font-weight: 600;">
            {fairfaxPwcAreas.join(' · ')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark" aria-labelledby="cta-heading">
    <div class="container" style="text-align: center;">
      <h2 id="cta-heading">Ready to cross off your home repair or remodeling list?</h2>
      <p style="max-width: 660px; margin-inline: auto;">
        Contact {site.shortName} today for a free, no-obligation flat-rate estimate—or call anytime
        for 24/7 emergency plumbing and electrical assistance.
      </p>
      <div class="actions center">
        <a class="btn btn-accent" href={`${homeUrl}contact/`}>Request a Free Estimate</a>
        <a class="btn btn-outline-light tabular" href={`tel:${site.contact.phone}`}>Call {site.contact.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Layout>
