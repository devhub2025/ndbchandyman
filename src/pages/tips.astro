---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.js';

const base = import.meta.env.BASE_URL;
const homeUrl = base.endsWith('/') ? base : `${base}/`;
const siteOrigin = Astro.site ? Astro.site.origin : 'https://devhub2025.github.io';

const title = 'Home Maintenance Tips';
const fullTitle = 'Home Maintenance Tips for Northern Virginia Homes | NDBC';
const description =
  'Practical seasonal home maintenance, deck care, energy-saving, and repair tips for homeowners in Leesburg and Northern Virginia.';

const breadcrumbs = [
  { name: 'Home', href: homeUrl },
  { name: 'Home Maintenance Tips', href: `${homeUrl}tips/` },
];

const tipsSchema = {
  '@type': 'Article',
  '@id': `${new URL(`${homeUrl}tips/`, siteOrigin).toString()}#article`,
  headline: 'Handyman Help: Remodeling & Home Maintenance Best Practices for Northern Virginia',
  description,
  author: {
    '@id': `${new URL(homeUrl, siteOrigin).toString()}#business`,
  },
  publisher: {
    '@id': `${new URL(homeUrl, siteOrigin).toString()}#business`,
  },
};
---

<Layout
  title={title}
  fullTitle={fullTitle}
  description={description}
  ogType="article"
  breadcrumbs={breadcrumbs}
  pageSchema={tipsSchema}
>
  <section class="page-hero">
    <div class="container">
      <span class="hero-badge">20+ Years of Field Experience</span>
      <h1>Handyman Tips &amp; Pre-Remodeling Checklists</h1>
      <p class="lead">
        {site.shortName} encourages informed homeowners. Read these essential structural, plumbing,
        and safety checks before starting any basement, kitchen, bathroom, or deck project in
        Northern Virginia.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="guides-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Prevent Costly Mistakes</span>
        <h2 id="guides-heading">What to inspect before remodeling or repairing your home</h2>
        <p>
          Most expensive remodeling failures happen behind the walls or under the tile where shortcuts
          hide until a leak appears. Here is what our licensed crew checks on every project.
        </p>
      </div>

      <div class="grid grid-2">
        <article class="card">
          <h3>1. Basement Remodeling: Foundation Cracks &amp; Pipe Corrosion</h3>
          <p>
            Before framing or finishing a basement, inspect all concrete walls and slabs for hairline
            cracks or fissures. Even small openings can become entry points for groundwater seepage
            or termites once hidden behind drywall.
          </p>
          <ul class="check-list">
            <li>Inspect existing supply and drain plumbing before closing ceilings or walls.</li>
            <li>Hard water minerals (calcium and magnesium) gradually corrode older copper pinholes.</li>
            <li>Replace any legacy galvanized steel piping before finishing the basement.</li>
          </ul>
        </article>

        <article class="card">
          <h3>2. Bathroom Remodeling: The 24-Hour Shower Pan Flood Test</h3>
          <p>
            Converting a bathtub into a walk-in tiled shower requires strict waterproofing to prevent
            sub-floor rot and ceiling leaks below.
          </p>
          <ul class="check-list">
            <li>First, a pre-sloped mortar bed must be set so water drains positively toward the weep holes.</li>
            <li>Second, install the waterproof pan liner, seal the drain temporarily, fill with water, and <strong>leave it for a full 24 hours</strong> to verify zero leaks.</li>
            <li>Only after passing the 24-hour flood test and curing the mortar bed should ceramic or porcelain tile be installed.</li>
          </ul>
        </article>

        <article class="card">
          <h3>3. Kitchen Remodeling: Pressure-Test Plumbing Before Cabinets</h3>
          <p>
            New kitchen cabinetry and countertops are a major investment that can be ruined by a slow
            valve or supply-line leak behind the base units.
          </p>
          <ul class="check-list">
            <li>Inspect and pressure-test all wall and floor plumbing lines <em>before</em> hanging shelves or setting base cabinets.</li>
            <li>Replace aging shut-off valves, dishwasher supply lines, and garbage disposal fittings during the remodel.</li>
            <li>Schedule periodic under-sink checks after installation to protect cabinet bases.</li>
          </ul>
        </article>

        <article class="card">
          <h3>4. Wooden Decks: Check Ledger Boards &amp; Sub-Framing for Rot</h3>
          <p>
            Surface power washing and staining will peel within a year if underlying moisture rot is
            ignored.
          </p>
          <ul class="check-list">
            <li>Probe deck boards, stair stringers, and the house ledger connection for soft wood fibers after winter snow and rain.</li>
            <li>Verify guardrail post connections against Virginia Uniform Statewide Building Code (USBC) standards.</li>
            <li><a href={`${homeUrl}services/deck-restoration/`}>Learn about our 6-step Wooden Deck Restoration process →</a></li>
          </ul>
        </article>

        <article class="card">
          <h3>5. DIY Electrical &amp; Ladder Safety</h3>
          <p>
            Even simple tasks like replacing chandeliers, ceiling fans, or high-ceiling light bulbs
            carry real risk when rushed.
          </p>
          <ul class="check-list">
            <li>Always turn off the wall switch <strong>and</strong> the circuit breaker at the main panel before touching fixture wiring.</li>
            <li>Use a stable, properly rated stepladder rather than chairs or stools—taking two minutes to set up a proper ladder prevents months of recovery from a fall.</li>
          </ul>
        </article>

        <article class="card">
          <h3>6. Verify Contractor Licensing &amp; Liability Insurance</h3>
          <p>
            Before hiring any handyman or remodeling contractor in Virginia, verify that they hold
            the appropriate license class and active general liability coverage.
          </p>
          <ul class="check-list">
            <li>Licensed under the Virginia Department of Professional and Occupational Regulation (DPOR).</li>
            <li>Active general liability insurance protects your home against accidental on-duty damage.</li>
            <li>Always insist on a written flat-rate scope and workmanship warranty.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="tips-cta">
    <div class="container" style="text-align: center;">
      <h2 id="tips-cta">Need a licensed pro to handle the job safely?</h2>
      <p style="max-width: 640px; margin-inline: auto;">
        From quick electrical and plumbing repairs to full kitchen, bathroom, and deck renovations,
        {site.name} gets it done right the first time.
      </p>
      <div class="actions center">
        <a class="btn btn-primary" href={`tel:${site.contact.phone}`}>Call {site.contact.phoneDisplay}</a>
        <a class="btn btn-accent" href={`${homeUrl}contact/`}>Request a Free Flat-Rate Estimate</a>
      </div>
    </div>
  </section>
</Layout>
